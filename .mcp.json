{
  "mcpServers": {
    "google-ads": {
      "command": "bash",
      "env": {
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN:-}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID:-}",
        "GOOGLE_CLOUD_PROJECT": "${GOOGLE_CLOUD_PROJECT:-able-balm-510520-v4}"
      },
      "args": [
        "scripts/google-ads-mcp.sh"
      ]
    },
    "kling": {
      "type": "http",
      "url": "https://kling.ai/mcp"
    }
  }
}
