{% comment %}
  MR — Öne Çıkan Ürünler (Premium Kart)
  Block bazlı, elle seçilen ürünler. Gerçek Shopify ürün verisi (fiyat/görsel/başlık) +
  custom alanlar (rozet, spec chip, spec satırı, sepet-indirim metni).
{% endcomment %}
{{ 'component-featured-products-premium.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="featured-products-premium color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="featured-products-premium__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="featured-products-premium__grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          <div class="card" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="card-media">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: product.featured_image.alt | default: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if block.settings.badge_type != 'none' and block.settings.badge_text != blank -%}
                <span class="badge badge--{{ block.settings.badge_type }}">{{ block.settings.badge_text | escape }}</span>
              {%- endif -%}

              {%- if block.settings.spec_chip != blank -%}
                <span class="spec-chip">{{ block.settings.spec_chip | escape }}</span>
              {%- endif -%}

              {%- if product.available and product.selected_or_first_available_variant != blank -%}
                <quick-add-button>
                  <button
                    type="button"
                    class="quick-add"
                    aria-label="{{ product.title | escape }} — hızlı sepete ekle"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/><path d="M6 6L4 3H2"/></svg>
                  </button>
                </quick-add-button>
              {%- endif -%}
            </a>

            <div class="card-body">
              <a href="{{ product.url }}" class="card-title">{{ product.title | escape }}</a>
              {%- if block.settings.spec_line != blank -%}
                <p class="card-spec-line">{{ block.settings.spec_line | escape }}</p>
              {%- endif -%}

              <div class="price-row">
                <span class="price-current{% if product.compare_at_price > product.price %} on-sale{% endif %}">
                  {{ product.price | money }}
                </span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>

              {%- if block.settings.cart_discount_text != blank -%}
                <div class="cart-discount">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M20 12V8H6a2 2 0 010-4h12v4"/><path d="M4 6v12a2 2 0 002 2h14v-4"/><path d="M18 12a2 2 0 000 4h4v-4z"/></svg>
                  <span>{{ block.settings.cart_discount_text | escape }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Öne Çıkan Ürünler",
  "class": "featured-products-premium-section",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Öne Çıkan Ürünler" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Üst boşluk", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Alt boşluk", "default": 56 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Ürün Kartı",
      "settings": [
        { "type": "product", "id": "product", "label": "Ürün" },
        {
          "type": "select", "id": "badge_type", "label": "Rozet tipi",
          "options": [
            { "value": "none", "label": "Yok" },
            { "value": "sale", "label": "İndirim (turuncu)" },
            { "value": "new", "label": "Yeni (lacivert)" },
            { "value": "low-stock", "label": "Düşük stok (gri)" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "badge_text", "label": "Rozet metni", "default": "İndirim" },
        { "type": "text", "id": "spec_chip", "label": "Spec chip (sağ üst)", "info": "Örn: 350 KG" },
        { "type": "text", "id": "spec_line", "label": "Spec satırı (başlık altı)", "info": "Örn: 105 CM · Şifreli Kilit" },
        { "type": "text", "id": "cart_discount_text", "label": "Sepet indirim metni", "info": "Örn: Sepette 10.000 TL Ekstra İndirim" }
      ]
    }
  ],
  "presets": [{ "name": "Öne Çıkan Ürünler" }]
}
{% endschema %}

<script>
  // MR — Öne Çıkan Ürünler / Quick Add — Dawn native cart-notification'a doğru bağlanır.
  // /cart/add.js'e `sections` gönderilir; dönen HTML cart-notification.renderContents ile
  // basılır (bildirim açılır + sepet sayacı güncellenir). Yeni kütüphane/iframe yok.
  if (!customElements.get('quick-add-button')) {
    customElements.define(
      'quick-add-button',
      class QuickAddButton extends HTMLElement {
        connectedCallback() {
          this.button = this.querySelector('button');
          if (this.button) this.button.addEventListener('click', this.onClick.bind(this));
        }

        onClick(evt) {
          evt.preventDefault();
          const variantId = this.button.dataset.variantId;
          if (!variantId) return;

          const notification = document.querySelector('cart-notification');
          const drawer = document.querySelector('cart-drawer');
          const config = {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/javascript' },
          };

          const body = { items: [{ id: variantId, quantity: 1 }] };
          const target = notification || drawer;
          if (target && typeof target.getSectionsToRender === 'function') {
            body.sections = target.getSectionsToRender().map((s) => s.id);
            body.sections_url = window.location.pathname;
          }

          this.button.setAttribute('aria-busy', 'true');

          fetch(`${routes.cart_add_url}`, {
            ...config,
            body: JSON.stringify(body),
          })
            .then((res) => res.json())
            .then((response) => {
              if (response.status) return; // hata (ör. stok yok)
              if (target && typeof target.renderContents === 'function') {
                target.renderContents(response);
              }
              // pubsub dinleyicileri de haberdar olsun
              if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
                publish(PUB_SUB_EVENTS.cartUpdate, { source: 'quick-add-premium' });
              }
            })
            .catch(() => {})
            .finally(() => this.button.removeAttribute('aria-busy'));
        }
      }
    );
  }
</script>
