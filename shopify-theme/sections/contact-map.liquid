{% comment %}
  MR — İletişim Sayfası Haritası
  Facade deseni: statik önizleme + tıklayınca yüklenen iframe (pagespeed için).
  Çerçeve marka imza motifiyle (köşe perçin) uyumlu.
{% endcomment %}
{{ 'component-contact-map.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="contact-map color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <div class="contact-map__frame" data-map-facade data-map-src="{{ section.settings.map_embed_src }}">
      <button type="button" class="contact-map__cta" data-map-trigger>
        <span class="contact-map__cta-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z"/><circle cx="12" cy="9" r="2.4"/></svg>
        </span>
        <span class="contact-map__cta-text">
          <span class="label">Haritada Gör</span>
          <span class="sub">{{ section.settings.address_line | escape }}</span>
        </span>
      </button>
      <div class="contact-map__iframe-wrap" hidden></div>
    </div>
  </div>
</div>

<script>
  // MR — İletişim Sayfası Haritası / Facade Tetikleyici (native JS, kütüphane yok)
  (function () {
    var facades = document.querySelectorAll('[data-map-facade]');
    facades.forEach(function (facade) {
      var trigger = facade.querySelector('[data-map-trigger]');
      var wrap = facade.querySelector('.contact-map__iframe-wrap');
      if (!trigger || !wrap) return;
      trigger.addEventListener('click', function () {
        var src = facade.dataset.mapSrc;
        if (!src) return;
        var iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.width = '100%';
        iframe.height = '450';
        iframe.style.border = '0';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.allowFullscreen = true;
        iframe.title = 'Çelik Kasacı Konum Haritası';
        wrap.appendChild(iframe);
        wrap.hidden = false;
        trigger.hidden = true;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "İletişim Haritası",
  "class": "contact-map-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" },
    { "type": "text", "id": "address_line", "label": "Adres (buton altında görünür)", "default": "Cihangir Mah. Bebe Sk. No: 8 B, Avcılar / İstanbul" },
    {
      "type": "text",
      "id": "map_embed_src",
      "label": "Google Maps embed linki",
      "info": "Google Maps > Paylaş > Harita yerleştir > iframe kodundaki src=\"...\" içindeki URL'yi yapıştırın (tüm iframe kodunu değil)."
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Üst boşluk", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Alt boşluk", "default": 48 }
  ],
  "presets": [{ "name": "İletişim Haritası" }]
}
{% endschema %}
