{% comment %}
  MR — Sabit İletişim Butonları (WhatsApp + Telefon)
  theme.liquid'e eklenir → site genelinde her sayfada sağ altta sabit görünür.
{% endcomment %}
{{ 'component-floating-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa = section.settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign tel = section.settings.phone_number | remove: ' '
  assign wa_text = section.settings.whatsapp_message | url_encode
-%}

{%- if section.settings.enable -%}
  <div class="mr-fcontact" aria-label="Hızlı iletişim">
    {%- if tel != blank -%}
      <a
        href="tel:{{ tel }}"
        class="mr-fcontact__btn mr-fcontact__btn--phone"
        aria-label="Telefonla bilgi al"
        data-contact-event="tel_click"
      >
        <span class="mr-fcontact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg>
        </span>
        <span class="mr-fcontact__label">{{ section.settings.phone_label | escape }}</span>
      </a>
    {%- endif -%}

    {%- if wa != blank -%}
      <a
        href="https://wa.me/{{ wa }}{% if wa_text != blank %}?text={{ wa_text }}{% endif %}"
        class="mr-fcontact__btn mr-fcontact__btn--wa"
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp ile yaz"
        data-contact-event="whatsapp_click"
      >
        <span class="mr-fcontact__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12 2C6.48 2 2 6.48 2 12c0 1.77.46 3.43 1.27 4.88L2 22l5.25-1.38A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
        </span>
        <span class="mr-fcontact__label">{{ section.settings.whatsapp_label | escape }}</span>
      </a>
    {%- endif -%}
  </div>
  <script>
    // Contact click events for Shopify customer-event pixels and dataLayer listeners.
    // Not wired to a Google Ads conversion yet (docs/tracking.md, finding 4).
    document.addEventListener('click', function (event) {
      var link = event.target.closest('[data-contact-event]');
      if (!link) return;
      var name = link.getAttribute('data-contact-event');
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: name, link_url: link.href });
      if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) {
        Shopify.analytics.publish(name, { link_url: link.href });
      }
    });
  </script>
{%- endif -%}

{%- if request.page_type == 'index' -%}
  {%- comment -%} Store (LocalBusiness) schema with confirmed facts only. Opening hours follow once confirmed (docs/NEEDS-CONFIRMATION.md 1). {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Store",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | json }},
      {%- if settings.logo %}
      "image": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      "telephone": "+905414451548",
      "email": "satis@celikkasaci.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Cihangir Mah. Bebe Sk. No: 8 B",
        "addressLocality": "Avcılar",
        "addressRegion": "İstanbul",
        "postalCode": "34310",
        "addressCountry": "TR"
      },
      "areaServed": { "@type": "City", "name": "İstanbul" },
      "sameAs": ["https://www.instagram.com/celikkasaci/"]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sabit İletişim",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Butonları göster", "default": true },
    { "type": "header", "content": "WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp numarası", "default": "905414451548", "info": "Ülke koduyla, boşluksuz. Örn: 905414451548" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp buton yazısı", "default": "WhatsApp" },
    { "type": "text", "id": "whatsapp_message", "label": "Hazır mesaj", "default": "Merhaba, kasalar hakkında bilgi almak istiyorum." },
    { "type": "header", "content": "Telefon" },
    { "type": "text", "id": "phone_number", "label": "Telefon numarası", "default": "+905414451548", "info": "Örn: +905414451548" },
    { "type": "text", "id": "phone_label", "label": "Telefon buton yazısı", "default": "Telefonla Bilgi Al" }
  ],
  "presets": [{ "name": "Sabit İletişim" }]
}
{% endschema %}
