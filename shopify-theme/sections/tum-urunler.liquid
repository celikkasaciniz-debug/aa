{% comment %}
  Tüm ürünler: every active product on the homepage, cheapest first.
  Uses the Dawn product card and grid so it looks like the featured collection.
{% endcomment %}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign urunler = collections.all.products | sort: 'price' -%}
<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    {%- if section.settings.title != blank -%}
      <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width">
        <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <ul class="grid product-grid contains-card contains-card--product grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down" role="list">
        {%- for product in urunler limit: section.settings.products_to_show -%}
          {%- liquid
            assign lazy = false
            if forloop.index > 4
              assign lazy = true
            endif
            assign skip = true
            if forloop.first
              assign skip = false
            endif
          -%}
          <li class="grid__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'adapt',
              image_shape: 'default',
              lazy_load: lazy,
              show_secondary_image: false,
              show_vendor: false,
              show_rating: false,
              skip_styles: skip,
              section_id: section.id,
              quick_add: 'none',
              product_view_context: 'collection'
            %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tüm ürünler (fiyata göre)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Başlık", "default": "Tüm modeller" },
    {
      "type": "select", "id": "heading_size", "label": "Başlık boyutu", "default": "h2",
      "options": [{ "value": "h2", "label": "Küçük" }, { "value": "h1", "label": "Orta" }, { "value": "h0", "label": "Büyük" }]
    },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 50, "step": 1, "label": "Gösterilecek ürün sayısı", "default": 50 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Masaüstü sütun", "default": 4 },
    {
      "type": "select", "id": "columns_mobile", "label": "Mobil sütun", "default": "2",
      "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }]
    },
    { "type": "checkbox", "id": "full_width", "label": "Tam genişlik", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Üst boşluk", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Alt boşluk", "default": 36 }
  ],
  "presets": [{ "name": "Tüm ürünler (fiyata göre)" }]
}
{% endschema %}
