{% comment %}
  MR: Kapasite Sınıfına Göre Keşfet
  Hero altı, 4 kartlı "hızlı karar" modülü. scheme-1 zemin, kartlar kendi tier renklerinde.
{% endcomment %}
{{ 'component-capacity-tiles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="capacity-tiles color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="capacity-tiles__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="capacity-tiles__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="capacity-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="capacity-tile capacity-tile--tier-{{ block.settings.tier }}"
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <span class="capacity-tile__icon" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 112
                | image_tag: loading: 'lazy', widths: '56, 84, 112', sizes: '56px', alt: ''
              }}
            {%- else -%}
              {% render 'icon-vault-tier', tier: block.settings.tier %}
            {%- endif -%}
          </span>
          {%- comment -%}
            The weight range comes from the kasa.agirlik_kg values of the
            linked collection, not from the typed setting, so the tile can
            never claim a range the products do not have (MASTER_PROMPT 0.4.4).
          {%- endcomment -%}
          {%- liquid
            assign tile_min = nil
            assign tile_max = nil
            assign tile_handle = block.settings.link | split: '/collections/' | last | split: '?' | first
            if block.settings.link contains '/collections/'
              for p in collections[tile_handle].products limit: 50
                assign kg = p.metafields.kasa.agirlik_kg.value
                if kg != blank
                  if tile_min == nil or kg < tile_min
                    assign tile_min = kg
                  endif
                  if tile_max == nil or kg > tile_max
                    assign tile_max = kg
                  endif
                endif
              endfor
            endif
          -%}
          <span class="capacity-tile__text">
            {%- if tile_min != nil and tile_max != nil and tile_max > tile_min -%}
              <span class="capacity-tile__weight">{{ tile_min }} ile {{ tile_max }}&nbsp;kg</span>
            {%- elsif tile_min != nil -%}
              <span class="capacity-tile__weight">{{ tile_min }}&nbsp;kg</span>
            {%- endif -%}
            <span class="capacity-tile__category">{{ block.settings.category | escape }}</span>
            {%- if block.settings.cap_text != blank -%}
              <span class="capacity-tile__cap">{{ block.settings.cap_text | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kapasite Sınıfı Kartları",
  "class": "capacity-tiles-section",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kapasite Sınıfına Göre Keşfet" },
    { "type": "text", "id": "subheading", "label": "Alt başlık", "default": "İhtiyacınıza uygun ağırlık ve koruma sınıfını seçin" },
    {
      "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Üst boşluk", "default": 56
    },
    {
      "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Alt boşluk", "default": 56
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kapasite Kartı",
      "settings": [
        { "type": "text", "id": "weight_range", "label": "Ağırlık aralığı (kullanılmıyor, ürün verisinden hesaplanır)" },
        { "type": "text", "id": "category", "label": "Kategori adı", "default": "Ev Tipi Kasa" },
        { "type": "text", "id": "cap_text", "label": "Alt etiket (opsiyonel)", "default": "Giriş Seviyesi Koruma" },
        {
          "type": "select", "id": "tier", "label": "Görsel yoğunluk seviyesi",
          "options": [
            { "value": "1", "label": "1: En hafif (nötr gri)" },
            { "value": "2", "label": "2: Pirinç" },
            { "value": "3", "label": "3: Açık turuncu" },
            { "value": "4", "label": "4: Dolu turuncu (en yüksek vurgu)" }
          ],
          "default": "1"
        },
        { "type": "image_picker", "id": "image", "label": "Ürün görseli (opsiyonel: boşsa placeholder ikon kullanılır)" },
        { "type": "url", "id": "link", "label": "Bağlantı (koleksiyon sayfası)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kapasite Sınıfı Kartları",
      "blocks": [
        { "type": "tile", "settings": { "category": "Ev Tipi Kasa", "cap_text": "Giriş Seviyesi Koruma", "tier": "1" } },
        { "type": "tile", "settings": { "category": "Ofis Tipi Kasa", "cap_text": "Orta Seviye Koruma", "tier": "2" } },
        { "type": "tile", "settings": { "category": "Zırhlı Seri", "cap_text": "Yüksek Seviye Koruma", "tier": "3" } },
        { "type": "tile", "settings": { "category": "Banka Tipi Kasa", "cap_text": "Kuyumcu ve iş yeri", "tier": "4" } }
      ]
    }
  ]
}
{% endschema %}
