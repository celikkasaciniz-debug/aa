{% comment %}
  MR — Bülten Popup (İndirim)
  Native {% form 'customer' %} → e-posta otomatik "Müşteriler" listesine kaydolur (newsletter tag'iyle).
  Sayfa açılınca gecikmeli çıkar; bir kez kapatılınca çerezle N gün tekrar çıkmaz (pagespeed + UX).
{% endcomment %}
{{ 'component-newsletter-popup.css' | asset_url | stylesheet_tag }}

<newsletter-popup
  class="mr-nlpopup"
  data-delay="{{ section.settings.delay_seconds }}"
  data-cookie-days="{{ section.settings.suppress_days }}"
  hidden
>
  <div class="mr-nlpopup__overlay" data-nlpopup-close></div>

  <div class="mr-nlpopup__card color-{{ section.settings.color_scheme }}" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
    <button type="button" class="mr-nlpopup__close" data-nlpopup-close aria-label="Kapat">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>

    {%- if section.settings.image != blank -%}
      <div class="mr-nlpopup__media">
        {{
          section.settings.image
          | image_url: width: 800
          | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 45vw, 90vw', class: 'mr-nlpopup__img', alt: section.settings.heading | escape
        }}
      </div>
    {%- endif -%}

    <div class="mr-nlpopup__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mr-nlpopup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="mr-nlpopup__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mr-nlpopup__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'mr-nlpopup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">
        {%- if form.posted_successfully? -%}
          <p class="mr-nlpopup__success">{{ section.settings.success_text | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="mr-nlpopup__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <div class="mr-nlpopup__field">
            <input
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.placeholder | escape }}"
              aria-label="E-posta"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            <button type="submit" class="mr-nlpopup__submit">{{ section.settings.button_label | escape }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="mr-nlpopup__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}

      <button type="button" class="mr-nlpopup__dismiss" data-nlpopup-close>{{ section.settings.dismiss_label | escape }}</button>
    </div>
  </div>
</newsletter-popup>

<script>
  // MR — Bülten Popup / Tetikleyici (native JS, kütüphane yok)
  (function () {
    var el = document.querySelector('newsletter-popup.mr-nlpopup');
    if (!el) return;

    var COOKIE = 'mr_nlpopup_dismissed';
    var days = parseInt(el.dataset.cookieDays, 10) || 7;
    var delay = (parseInt(el.dataset.delay, 10) || 4) * 1000;

    function hasCookie() {
      return document.cookie.split('; ').indexOf(COOKIE + '=1') !== -1;
    }
    function setCookie() {
      var d = new Date();
      d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
      document.cookie = COOKIE + '=1; expires=' + d.toUTCString() + '; path=/; SameSite=Lax';
    }
    function open() {
      el.hidden = false;
      document.documentElement.classList.add('mr-nlpopup-open');
    }
    function close() {
      el.hidden = true;
      document.documentElement.classList.remove('mr-nlpopup-open');
      setCookie();
    }

    // Form başarıyla gönderildiyse (Shopify sayfayı ?...#... ile yeniden yükler) popup'ı açık göster
    var justPosted = el.querySelector('.mr-nlpopup__success');
    if (justPosted) {
      open();
    } else if (!hasCookie()) {
      setTimeout(open, delay);
    }

    el.querySelectorAll('[data-nlpopup-close]').forEach(function (btn) {
      btn.addEventListener('click', close);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !el.hidden) close();
    });
  })();
</script>

{% schema %}
{
  "name": "Bülten Popup",
  "class": "mr-nlpopup-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Görsel (sol taraf)" },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "ÇELİK KASACI" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Abone Ol, İlk Siparişinde %10 İndirim Kazan" },
    { "type": "textarea", "id": "subheading", "label": "Alt metin", "default": "E-posta listemize katıl; %10 indirim kodunu ve yeni kasa modellerinden ilk sen haberdar ol." },
    { "type": "text", "id": "placeholder", "label": "E-posta alanı yer tutucu", "default": "E-posta adresin" },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Abone Ol" },
    { "type": "text", "id": "dismiss_label", "label": "Vazgeç metni", "default": "Şimdi değil" },
    { "type": "text", "id": "success_text", "label": "Başarı mesajı", "default": "Teşekkürler! %10 indirim kodun e-posta adresine gönderildi." },
    { "type": "text", "id": "disclaimer", "label": "Küçük not (opsiyonel)", "default": "İstediğin zaman abonelikten çıkabilirsin." },
    { "type": "header", "content": "Davranış" },
    { "type": "range", "id": "delay_seconds", "min": 0, "max": 20, "step": 1, "unit": "sn", "label": "Açılma gecikmesi", "default": 4 },
    { "type": "range", "id": "suppress_days", "min": 1, "max": 60, "step": 1, "unit": "gün", "label": "Kapatınca tekrar çıkmama süresi", "default": 7 }
  ],
  "presets": [{ "name": "Bülten Popup" }]
}
{% endschema %}
