    "faq_premium_CPgnfH": {
      "type": "faq-premium",
      "blocks": {
        "question_mxQUUM": {
          "type": "question",
          "settings": {
            "question": "Kasalar nasıl teslim ediliyor, kurulum dahil mi?",
            "answer": "<p>Evet, tüm kasalarımız İstanbul içi ücretsiz teslimat ve kurulum ile gönderilir. Kurulum ekibimiz kasayı belirlediğiniz noktaya taşır, sabitler ve kullanım eğitimi verir.</p>"
          }
        },
        "question_WQaine": {
          "type": "question",
          "settings": {
            "question": "İstanbul dışına teslimat yapıyor musunuz?",
            "answer": "<p>Teslimat ve kurulum İstanbul içinde ücretsizdir. İstanbul dışı için sipariş vermeden önce 0541 445 15 48'i arayın; bölgenize göre fiyat ve süreyi bildirelim.</p>"
          }
        },
        "question_b4bMtz": {
          "type": "question",
          "settings": {
            "question": "Kasa şifresini unutursam ne olur?",
            "answer": "<p>Şifrenizi unutmanız durumunda yetkili servisimiz kimlik doğrulaması sonrası kasanızı açar ve şifrenizi sıfırlar. Kullanıcı kaynaklı unutma durumunda bu hizmet ücretlidir; kilit arızasından kaynaklanan durumlarda garanti kapsamındadır.</p>"
          }
        },
        "question_fXazBr": {
          "type": "question",
          "settings": {
            "question": "Hangi ödeme yöntemlerini kabul ediyorsunuz?",
            "answer": "<p>Kredi ve banka kartı (PayTR) ile kapıda ödeme.</p>"
          }
        },
        "question_zp7MdM": {
          "type": "question",
          "settings": {
            "question": "Garanti süresi ne kadar?",
            "answer": "<p>Tüm kasalarımız 2 yıl garanti kapsamındadır; kilit mekanizması ve gövde kaynaklarını kapsar.</p>"
          }
        },
        "question_wcbqwD": {
          "type": "question",
          "settings": {
            "question": "İade/değişim yapabilir miyim?",
            "answer": "<p>Detaylı bilgi için İade ve İptal Politikası sayfamızı inceleyebilirsiniz.</p>"
          }
        },
        "question_XEUztJ": {
          "type": "question",
          "settings": {
            "question": "Kasa çok ağır, taşıma/montaj nasıl yapılıyor?",
            "answer": "<p>Kurulum ekibimiz gerekli ekipmanla kasayı güvenli şekilde taşır ve yerleştirir; siz hiçbir fiziksel işlem yapmazsınız.</p>"
          }
        },
        "question_xywY3V": {
          "type": "question",
          "settings": {
            "question": "Toplu/kurumsal alımlarda indirim var mı?",
            "answer": "<p>Ofis, banka, kuyumcu gibi kurumsal toplu alımlarda özel fiyatlandırma sunuyoruz. 0541 445 15 48'den bize ulaşabilirsiniz.</p>"
          }
        }
      },
